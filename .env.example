# Server-only secrets. Copy this file to .env and fill in the values locally.
GROQ_API_KEY=
GROQ_API_KEY_2=
COHERE_API_KEY=

# Qdrant Cloud: keep the URL without a trailing slash.
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=nasa_knowledge

# Standalone API / Render configuration.
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Public frontend variable; never put a secret in a VITE_ variable.
# Local split deployment: http://localhost:3000
# Vercel + Render: https://YOUR-SERVICE.onrender.com
# Vercel-only deployment: leave empty
VITE_API_URL=

# Cloudinary (server-side, only for `npm run media:upload`). Either the single URL
# from the Cloudinary dashboard, or the three values below it.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public: when set, images, video, music and 3D models load from Cloudinary instead of /public (docs/cloudinary.md).
# The cloud name is not a secret. Leave empty to serve the files from /public.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_FOLDER=echo

# ROVER's Moon mailbox (server-side): messages children write at the end of the story are emailed here.
# With Gmail, SMTP_USER is the sending Gmail address and SMTP_PASS is a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords), never the normal password.
MOON_MAIL_TO=
SMTP_USER=
SMTP_PASS=
# Optional: defaults are smtp.gmail.com, port 465, and SMTP_USER as the sender.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
