# Server-only secrets. Copy this file to .env and fill in the values locally.
GROQ_API_KEY=
GROQ_API_KEY_2=
COHERE_API_KEY=

# Qdrant Cloud: keep the URL without a trailing slash.
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=nasa_knowledge

# Standalone API / Render configuration.
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Public frontend variable; never put a secret in a VITE_ variable.
# Local split deployment: http://localhost:3000
# Vercel + Render: https://YOUR-SERVICE.onrender.com
# Vercel-only deployment: leave empty
VITE_API_URL=
